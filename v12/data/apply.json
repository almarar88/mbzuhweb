, \"l\": \"diploma\", \"c\": \"كلية الدراسات العليا\", \"u\": \"colleges/graduate-studies.html#p-0\", \"h\": \"\"}, {\"id\": \"p5\", \"n\": \"ماجستير الآداب في اللغة العربية — تخصص اللغة واللسانيات\", \"l\": \"master\", \"c\": \"كلية الدراسات العليا\", \"u\": \"colleges/graduate-studies.html#p-1\", \"h\": \"36 ساعة\"}, {\"id\": \"p6\", \"n\": \"ماجستير الآداب في اللغة العربية — تخصص أدب\", \"l\": \"master\", \"c\": \"كلية الدراسات العليا\", \"u\": \"colleges/graduate-studies.html#p-2\", \"h\": \"36 ساعة\"}, {\"id\": \"p7\", \"n\": \"ماجستير فقه الواقع\", \"l\": \"master\", \"c\": \"كلية الدراسات العليا\", \"u\": \"colleges/graduate-studies.html#p-3\", \"h\": \"36 ساعة\"}, {\"id\": \"p8\", \"n\": \"ماجستير فقه الخطاب الشرعي\", \"l\": \"master\", \"c\": \"كلية الدراسات العليا\", \"u\": \"colleges/graduate-studies.html#p-4\", \"h\": \"48 ساعة\"}, {\"id\": \"p9\", \"n\": \"الدكتوراه في الاجتهاد الشرعي في القضايا المعاصرة\", \"l\": \"phd\", \"c\": \"كلية الدراسات العليا\", \"u\": \"colleges/graduate-studies.html#p-5\", \"h\": \"54 ساعة\"}, {\"id\": \"p10\", \"n\": \"دكتوراه الفلسفة في اللغة العربية وآدابها\", \"l\": \"phd\", \"c\": \"كلية الدراسات العليا\", \"u\": \"colleges/graduate-studies.html#p-6\", \"h\": \"60 ساعة\"}, {\"id\": \"p11\", \"n\": \"ماجستير دراسات الأديان\", \"l\": \"master\", \"c\": \"كلية الدراسات العليا\", \"u\": \"colleges/graduate-studies.html#p-7\", \"h\": \"\"}, {\"id\": \"p12\", \"n\": \"ماجستير التسامح والتعايش\", \"l\": \"master\", \"c\": \"كلية الدراسات العليا\", \"u\": \"colleges/graduate-studies.html#p-8\", \"h\": \"\"}, {\"id\": \"p13\", \"n\": \"دبلوم الدراسات العليا في التسامح والتعايش\", \"l\": \"diploma\", \"c\": \"كلية الدراسات العليا\", \"u\": \"colleges/graduate-studies.html#p-9\", \"h\": \"\"}, {\"id\": \"p14\", \"n\": \"ماجستير الأدب الشعبي الإماراتي\", \"l\": \"master\", \"c\": \"كلية الدراسات العليا\", \"u\": \"colleges/graduate-studies.html#p-10\", \"h\": \"\"}, {\"id\": \"p15\", \"n\": \"ماجستير الإعلام الرقمي\", \"l\": \"master\", \"c\": \"كلية الدراسات العليا\", \"u\": \"colleges/graduate-studies.html#p-11\", \"h\": \"\"}, {\"id\": \"p16\", \"n\": \"دبلوم الدراسات العليا في التحصين الفكري وتفكيك خطاب التطرف\", \"l\": \"diploma\", \"c\": \"كلية الدراسات العليا\", \"u\": \"colleges/graduate-studies.html#p-12\", \"h\": \"\"}], \"req\": {\"bachelor\": {\"general\": [\"الحصول على شهادة الثانوية العامة أو ما يعادلها.\", \"الحصول على درجة لا تقل عن (75) في مادة اللغة العربية في الثانوية العامة، أو اجتياز اختبار اللغة العربية الخاص بالجامعة.\", \"اجتياز المقابلة الشخصية.\", \"تحقيق الحد الأدنى من المعدل العام بحسب نوع الشهادة كما هو موضح في الجدول أدناه.\"], \"certs\": [[\"elite\", \"مسار النخبة\", \"معدل عام لا يقل عن 70%\", 70, \"uae\"], [\"adv\", \"المسار المتقدم\", \"معدل عام لا يقل عن 70%\", 70, \"uae\"], [\"gen\", \"المسار العام\", \"معدل عام لا يقل عن 80%\", 80, \"uae\"], [\"ats\", \"مدارس الثانوية الفنية المتقدمة (ATS)\", \"معدل عام لا يقل عن 80%\", 80, \"uae\"], [\"sabis\", \"نظام SABIS\", \"معدل عام لا يقل عن 70%\", 70, \"other\"], [\"ib\", \"البكالوريا الدولية (IB)\", \"دبلوم البكالوريا الدولية بدرجة لا تقل عن 24 نقطة، ويستثنى منها النقاط الإضافية\", null, \"other\"], [\"us\", \"النظام الأمريكي\", \"معدل عام لا يقل عن 80% أو معدل تراكمي لا يقل عن 3 (على مقياس 4) أو ما يعادله\", 80, \"other\"], [\"uk\", \"النظام البريطاني (GCE/IGCSE)\", \"إجمالي ثمانية مواد، خمسة منها على مستوى (O) وثلاثة منها على مستوى (AS/A)، بمعدل C كحد أدنى في جميع المواد. لا يتم احتساب مادتي اللغة العربية والتربية الإسلامية.\", null, \"other\"]], \"colleges\": {\"كلية الدراسات الإسلامية\": [\"حصول الطالب على درجة (85) في مادة التربية الإسلامية في الثانوية العامة.\", \"إجادة تلاوة القرآن الكريم مع مراعاة أحكام التجويد.\", \"حفظ أجزاء من القرآن الكريم.\"], \"كلية العلوم الاجتماعية والإنسانية\": [\"حصول الطالب على درجة (85) في مادة اللغة العربية أو التربية الإسلامية أو أي مادة ذات صلة ببرامج الكلية في الثانوية العامة أو ما يعادلها.\"], \"كلية الآداب واللغات\": [\"معدل عام لا يقل عن 85% أو معدل تراكمي لا يقل عن 3 (ع