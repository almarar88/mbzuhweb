a href=\"/mbzuhweb/v12/magazine/b-the-national-school.html\"><div class=\"mg-img\"><img alt=\"\" decoding=\"async\" loading=\"lazy\" src=\"/mbzuhweb/assets/img/o/1788764619452-01-school-799c22.webp\"/></div><div class=\"mg-b\"><span class=\"mg-sec\">من رفوف الإصدارات</span><h3>المدرسة الوطنية</h3><span class=\"mg-meta\">إصدارات الجامعة · <span class=\"numx\">1</span> د قراءة</span></div></a></article></div></div></section>"}], "scripts": ["site", "pages", "v6", "mag"], "css": ["fonts.css", "site.css", "pages.css", "v4.css", "v5.css", "v6.css", "cec.css", "apply.css", "hubs.css"], "json": []}